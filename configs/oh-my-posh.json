{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#c4a7e7",
          "template": "{{ .UserName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#9ccfd8",
          "properties": {
            "style": "full"
          },
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#f6c177",
          "properties": {
            "display_stash_count": false,
            "display_upstream_icon": false
          },
          "template": "{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#ebbcba",
          "template": "❯",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    }
  ],
  "version": 3
}
